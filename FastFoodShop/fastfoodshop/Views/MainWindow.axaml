<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:fastfoodshop.ViewModels"
        x:Class="fastfoodshop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Информационная система ресторана" Width="1100" Height="720"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF">

    <DockPanel>
        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top" Background="#EEEEEE" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- Вывод ФИО пользователя -->
                    <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                    <!-- Кнопки, видимые только для менеджера и админа -->
                    <Button Content="Управление меню" IsVisible="{Binding CanManageMenu}" Click="OpenMenu_Click"/>
                    <Button Content="Отчёты" IsVisible="{Binding CanManageMenu}" Click="OpenReport_Click"/>

                    <!-- История заказов доступна всем сотрудникам -->
                    <Button Content="Заказы" Click="OpenOrders_Click"/>

                    <!-- Кнопки, видимые только для админа -->
                    <Button Content="Пользователи" IsVisible="{Binding CanManageUsers}" Click="OpenUsers_Click"/>
                </StackPanel>

                <!-- Статус подключения к БД -->
                <TextBlock Grid.Column="1" Text="{Binding DbStatus}" VerticalAlignment="Center"
                           Foreground="#0078D7" FontWeight="SemiBold" Margin="10,0"/>
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#333333"/>
        </Border>

        <!-- Рабочая область -->
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: Меню (Список блюд из базы) -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,10,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Доступное меню" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Поиск и количество -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Поиск по названию или категории"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                            <TextBlock Text="Кол-во:" VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding Quantity, Mode=TwoWay}" Minimum="0" Maximum="99"
                                           Increment="1" Width="100" FormatString="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Вот здесь выводится список блюд -->
                    <ListBox ItemsSource="{Binding MenuItems}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Category.CategoryName}" Foreground="Gray" FontSize="12"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} руб.'}" Foreground="#0078D7" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Добавить"
                                            Command="{Binding $parent[Window].DataContext.AddToCartCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Правая часть: Корзина -->
            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Текущий заказ" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Карта постоянного клиента -->
				 <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Карта постоянного клиента:" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

					<!-- Итоговая сумма и действия -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Сумма:"/>
                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:N2} руб.'}"/>
                        </Grid>
                        <TextBlock Text="{Binding DiscountText}" FontSize="12" Foreground="#0078D7" TextWrapping="Wrap"/>
                        <TextBlock Text="Итого:" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TotalSum, StringFormat='{}{0:N2} руб.'}" FontSize="24" FontWeight="Bold" Foreground="#008000"/>
                        <TextBlock Text="{Binding LastOrderText}" FontSize="12" Foreground="#008000" TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                            <Button Content="Оплатить" Command="{Binding PayCommand}" Height="40" Margin="0,0,5,0"
                                    Background="#0078D7" Foreground="White" FontWeight="Bold"/>
                            <Button Grid.Column="1" Content="Очистить" Command="{Binding ClearCartCommand}" Height="40" Margin="5,0,0,0"/>
                        </Grid>

                        <Button Content="Закрыть заказ" Command="{Binding CloseOrderCommand}"
                                IsVisible="{Binding HasLastOrder}" Height="35" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Список того, что в корзине -->
                    <ListBox ItemsSource="{Binding Cart}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MenuItem.ItemName}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LineSum, StringFormat='{}{0:N2} руб.'}" Foreground="Gray" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="−" Width="30" Height="28"
                                                Command="{Binding $parent[Window].DataContext.DecreaseQuantityCommand}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" MinWidth="20" TextAlignment="Center"/>
                                        <Button Content="+" Width="30" Height="28"
                                                Command="{Binding $parent[Window].DataContext.IncreaseQuantityCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="✕" Width="30" Height="28"
                                                Command="{Binding $parent[Window].DataContext.RemoveFromCartCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
