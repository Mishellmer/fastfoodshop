<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="fastfoodshop.Views.LoginWindow"
        Title="Авторизация"
        Width="420" Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#FFFFFF">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Логин:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" Name="LoginTextBox" PlaceholderText="Введите логин"
                 Margin="0,0,0,12" KeyDown="Credential_KeyDown"/>

        <TextBlock Grid.Row="3" Text="Пароль:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="4" Name="PasswordTextBox" PasswordChar="●" PlaceholderText="Введите пароль"
                 Margin="0,0,0,12" KeyDown="Credential_KeyDown"/>

        <TextBlock Grid.Row="5" Name="ErrorTextBlock" Foreground="Red" TextWrapping="Wrap"
                   Margin="0,0,0,8" MinHeight="18"/>

        <TextBlock Grid.Row="6" Name="DbStatusText" Text="БД: проверка подключения..."
                   Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Button Grid.Row="7" Name="LoginButton" Content="Войти"
                HorizontalAlignment="Stretch" Height="40"
                Background="#0078D7" Foreground="White" FontWeight="Bold"
                Click="LoginButton_Click"/>

        <TextBlock Grid.Row="8" Text="Информационная система ресторана быстрого питания"
                   HorizontalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,12,0,0"/>
    </Grid>
</Window>
