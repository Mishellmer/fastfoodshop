<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:fastfoodshop.ViewModels"
        x:Class="fastfoodshop.Views.MenuWindow"
        x:DataType="vm:MenuViewModel"
        Title="Управление меню" Width="1000" Height="650"
        WindowStartupLocation="CenterOwner" Background="#FFFFFF">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEEEEE" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Управление меню и стоп-листом" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#333333"/>
        </Border>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,15,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Позиции меню" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Category.CategoryName}" Foreground="Gray" FontSize="12"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} руб.'}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding AvailabilityText}" Foreground="#0078D7"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                    <TextBlock Text="Карточка позиции" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Наименование:" FontSize="12"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Например, Чизбургер"/>

                    <TextBlock Text="Цена, руб.:" FontSize="12" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding PriceText, Mode=TwoWay}" PlaceholderText="149,00"/>

                    <TextBlock Text="Категория:" FontSize="12" Margin="0,6,0,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CategoryName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Content="Доступно для продажи (не в стоп-листе)"
                              IsChecked="{Binding IsAvailable, Mode=TwoWay}" Margin="0,10,0,0"/>

                    <Grid ColumnDefinitions="*,*" Margin="0,14,0,0">
                        <Button Content="Добавить" Command="{Binding AddCommand}" Height="36" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Сохранить" Command="{Binding SaveCommand}" Height="36" Margin="5,0,0,0"
                                Background="#0078D7" Foreground="White"/>
                    </Grid>

                    <Button Content="Удалить позицию" Command="{Binding DeleteCommand}" Margin="0,8,0,0"/>
                    <Button Content="Переключить стоп-лист" Command="{Binding ToggleAvailabilityCommand}" Margin="0,8,0,0"/>

                    <TextBlock Text="Для удаления доступны только позиции, не использованные в заказах. Остальные снимайте с продажи через стоп-лист."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
